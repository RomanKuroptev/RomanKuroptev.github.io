---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 10);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.posts { list-style: none; padding: 0; }
			.posts li { margin-bottom: 1.5em; }
			.posts a { text-decoration: none; font-size: 1.25em; font-weight: 700; }
			.posts .meta { color: rgb(var(--gray)); font-size: 0.9em; margin: 0.2em 0 0; }
			.posts .desc { margin: 0.3em 0 0; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Hi, I'm Roman.</h1>
			<p>
				I'm a developer and architect. This is where I write about software architecture, AI,
				and the things I build, including <strong>forkling</strong>, an AI that grows its own 3D
				world.
			</p>
			<h2>Latest posts</h2>
			<ul class="posts">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						<p class="meta">
							<FormattedDate date={post.data.pubDate} />
							{post.data.tags.length > 0 && <> · {post.data.tags.join(', ')}</>}
						</p>
						<p class="desc">{post.data.description}</p>
					</li>
				))}
			</ul>
			<p><a href="/blog">All posts →</a></p>
		</main>
		<Footer />
	</body>
</html>
